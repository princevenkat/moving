{
    "compilerOptions": {
        //"types": ["vite/client"],
        "types": ["vite/client", "node"],
        "moduleResolution": "node",
        "target": "esnext",
        "module": "esnext",
        "jsx": "preserve",
        "esModuleInterop": true,
        "strict": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"]
        }
    },
    "include": ["resources/**/*.ts", "resources/**/*.tsx", "resources/**/*.vue"]
}
